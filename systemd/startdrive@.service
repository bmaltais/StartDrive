[Unit]
Description=StartDrive mount (%i)
Documentation=https://github.com/bmaltais/StartDrive
After=network-online.target graphical-session.target
Wants=network-online.target
# The config password lives in the login keyring; without a session bus it
# cannot be read, so stay attached to the graphical session.
PartOf=graphical-session.target

[Service]
Type=notify
# rclone reads the encrypted config through the keyring, never from a variable
# that holds the key itself.
Environment=RCLONE_PASSWORD_COMMAND="secret-tool lookup service omarchy-cloud-drives key config-password"
Environment=RCLONE_CONFIG=%h/.config/rclone/rclone.conf
# Per-drive settings. rclone reads its own flags from RCLONE_* variables, so
# the defaults below are overridden by ~/.config/startdrive/<remote>.env
# (written by `startdrive set`) without templating the unit.
Environment=RCLONE_VFS_CACHE_MAX_SIZE=4G
Environment=RCLONE_VFS_CACHE_MAX_AGE=72h
Environment=RCLONE_READ_ONLY=false
# While Google throttles the shared rclone client id, every API call backs off
# and retries, and a directory listing holds the directory lock the whole time
# so every ls queues behind it. Fewer retries make a throttled listing fail
# (EIO, retried on the next ls) instead of hanging for minutes.
Environment=RCLONE_LOW_LEVEL_RETRIES=3
EnvironmentFile=-%h/.config/startdrive/%i.env
# A private 0700 directory per mount for rclone's remote-control socket, which
# the panel uses for transfer activity and cache controls. A unix socket in a
# 0700 directory needs no password and is reachable only by this user.
RuntimeDirectory=startdrive/%i
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/mkdir -p -m 0700 %h/Cloud/%i %h/.cache/rclone
ExecStart=/usr/bin/rclone mount %i: %h/Cloud/%i \
  --vfs-cache-mode full \
  --dir-cache-time 1h \
  --poll-interval 15s \
  --umask 077 \
  --allow-other=false \
  --rc --rc-addr=unix://%t/startdrive/%i/rc.sock --rc-no-auth \
  --log-level NOTICE
ExecStop=/usr/bin/fusermount3 -uz %h/Cloud/%i
TimeoutStopSec=20
Restart=on-failure
RestartSec=10
UMask=0077
# fusermount3 is setuid root, so NoNewPrivileges/RestrictSUIDSGID would break
# the mount. Unprivileged FUSE is the security boundary here instead.
# No mount-namespace sandboxing (PrivateTmp, ProtectSystem/Home/Kernel*/ControlGroups):
# each of those puts the service in a private mount namespace, where fusermount3
# refuses to mount and the FUSE mount would be invisible to the session anyway.
# Nor seccomp options (LockPersonality, RestrictRealtime, SystemCallFilter...):
# for user services they imply no_new_privs, which also breaks fusermount3.

[Install]
WantedBy=graphical-session.target
