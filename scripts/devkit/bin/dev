#!/usr/bin/env bash
# dev: test an Omarchy plugin in a nested desktop that your mouse and keyboard cannot reach.
#
#   dev up                      start the session: a second Hyprland and Omarchy shell, the app's checkout as the plugin, and the
#                               view window on your screen (DEV_WATCH=0 for none; DEV_SIZE=WxH for another screen size)
#   dev reload                  restart that shell so it loads the checkout's current files (uncommitted changes too)
#   dev ipc TARGET METHOD [ARG...]   call the plugin's IPC in the session: omarchy-shell TARGET METHOD ARG... there
#   dev run CMD [ARG...]        start a program inside the session (foot -a demo sleep 600: a throwaway window)
#   dev windows                 the session's windows: class, title, workspace
#   dev set JSON                merge settings into the plugin's entry in the session's shell.json, e.g. '{"colorScheme":"dark"}'
#   dev env                     shell code that puts a script in the session's environment: eval "$(dev env)" (the session's home,
#                               its guard first on PATH, its compositor: hyprctl, omarchy-shell and foot then act there)
#   dev click PX PY             click at pixel PX,PY of a screenshot of the session
#   dev rclick PX PY            right-click at pixel PX,PY
#   dev scroll PX PY N          turn the wheel N notches over that pixel (positive: down, negative: up)
#   dev move PX PY              move the pointer there without clicking (hover, or park the pointer off a card before a screenshot)
#   dev type TEXT               type into the window that has the keyboard
#   dev key NAME                press a key: Escape, Return, BackSpace, Tab, ...
#   dev shot [FILE]             screenshot the session (path printed)
#   dev watch | unwatch         open / close a view-only window on your screen showing the session live
#   dev errors                  what the plugin logged there, with the shell's usual noise removed
#   dev status | down           is it up / end it
#
# The app adds commands of its own in its devkit.conf (a function dev_cmd_NAME, see docs/configuration.md), listed under its own
# usage text: `dev --help`.
#
# Where it lives. `up` puts the session's window on a virtual monitor of its own, placed 20,000 px to the right where a real
# pointer cannot go (sliding a mouse off the edge of the screen stops at the edge). Nothing is drawn over your desktop, your
# mouse and keyboard cannot touch it, and nothing of yours is read or written: the session has a home of its own, and a guard in
# front of its PATH refuses the commands that would act on your machine (a plugin's Shut down, Restart, Sleep, Sign out and
# Lock: lib/session.sh). Every click and key goes to the session's own Wayland socket (a virtual pointer and keyboard), the plugin
# there is linked to this checkout so `reload` needs no commit or push, and your real shell is never restarted. Its bar says
# "TEST SESSION" (the window's own title is fixed by the nested compositor, "aquamarine - WAYLAND-N").
#
# Watching it: `watch` opens a view-only window (lib/dev-view.qml) that shows the session five times a second. It is an ordinary
# window of its own, so your pointer is the normal arrow over it and you can drag, cover or resize it. The session's own window is
# never put on your screen: while your pointer is over a nested compositor's window, that compositor chooses the cursor image
# (hidden, a hand, a block), and moving or dropping it left a real pointer behaving oddly. Or just take a `dev shot`.
#
# The session closes by itself after DEV_TTL seconds (default 1800), and a window closed by hand is cleaned up by the next `up`.
# Pixels are those of the session's screen, 1280x800 unless DEV_SIZE=WxH says otherwise (a bigger one for sharper screenshots), 0,0 at the top-left: take a `dev shot`, read the pixel off it, click.
# Every command prints one line, and exits non-zero when it did not do what it says. (DEV_QUIET=1 leaves out the notes a click or a key
# prints when the app's window is not open, for a script that clicks on purpose.)
set -euo pipefail

SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/dev
# shellcheck source=../lib/config.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/config.sh"
devkit_load_config || exit 1
DEV=${XDG_RUNTIME_DIR:-/run/user/$UID}/$DEVKIT_NAME-dev
STATE=$DEV/state
TTL=${DEV_TTL:-1800}
FAR_MON=DEVTEST
FAR_X=20000

# What lib/session.sh needs from its caller (the recorder sets the same names).
TMP=$DEV
DEV_SIZE=${DEV_SIZE:-1280x800}              # the session's screen, WxH (the recorder's TOUR_SIZE)
W=${DEV_SIZE%x*}
H=${DEV_SIZE#*x}
REAL_HOME=$HOME                             # session.sh swaps HOME for the sandbox; the view window needs the real one
NEST_LABEL="TEST SESSION: dev"              # shown on the nested bar (session.sh adds it)
orig_mon=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name' || true)
gx=0; gy=0
# shellcheck source=../lib/session.sh
source "$DEVKIT/lib/session.sh"
ID=$TOUR_PLUGIN_ID

die() { echo "dev: $*" >&2; exit 1; }
usage() {
  sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'
  [[ -z $DEVKIT_USAGE ]] || { echo; echo "Commands of $DEVKIT_NAME (from $DEVKIT_CONF):"; printf '%s\n' "$DEVKIT_USAGE"; }
}

# The session's own environment, for running the shell's commands inside it.
nenv() { env HOME="$NEST_HOME" XDG_CONFIG_HOME="$NEST_HOME/.config" XDG_DATA_HOME="$NEST_HOME/.local/share" \
  XDG_STATE_HOME="$NEST_HOME/.local/state" XDG_CACHE_HOME="$NEST_HOME/.cache" PATH="$GUARD:$PATH" \
  WAYLAND_DISPLAY="$NWD" HYPRLAND_INSTANCE_SIGNATURE="$NSIG" ${DEVKIT_ENV[@]+"${DEVKIT_ENV[@]}"} "$@"; }
nested_alive() { HYPRLAND_INSTANCE_SIGNATURE=$NSIG hyprctl monitors -j >/dev/null 2>&1; }
load() { [[ -s $STATE ]] || die "no session: run dev up"; source "$STATE"; nested_alive || die "the session is gone: run dev up"; }
# Is the app's window up in the session? By default: is a layer-shell surface of one of DEVKIT_LAYERS mapped. An app whose window is
# not a layer of its own defines devkit_window_up in its devkit.conf (it can use nenv and layer_mapped).
layer_mapped() { HYPRLAND_INSTANCE_SIGNATURE=$NSIG hyprctl layers -j | jq -e --arg ns "$1" '[.. | .namespace? // empty] | any(. == $ns)' >/dev/null 2>&1; }
overlay_up() {
  if declare -F devkit_window_up >/dev/null; then devkit_window_up; return; fi
  local ns
  for ns in "${DEVKIT_LAYERS[@]:-}"; do [[ -n $ns ]] && layer_mapped "$ns" && return 0; done
  return 1
}
shell_up() { [[ $(nenv omarchy-shell shell ping 2>/dev/null) == ok ]]; }
wait_shell() { local i; for i in $(seq 1 60); do shell_up && return 0; sleep 0.5; done; return 1; }

noise='recursive rearrange|Local plugin changed|qt\.svg|IpcHandler|ShellIpc|Handler was registered|qmlscanner|DEBUG|atspi|portal'
[[ -z $DEVKIT_NOISE ]] || noise="$noise|$DEVKIT_NOISE"
plugin_errors() { # prints the plugin's logged errors, one per line
  [[ -f $NEST/qs.log ]] || return 0
  sed 's/\x1b\[[0-9;]*m//g' "$NEST/qs.log" |
    grep -F "$TOUR_PLUGIN_ID" |
    grep -E "WARN|ERROR|ReferenceError|TypeError|Unable to assign|Cannot (assign|read|call)|is not a type|is not defined|failed|Read of" |
    grep -vE "$noise" | sort -u || true
}

cmd_up() {
  if [[ -s $STATE ]]; then
    if source "$STATE" && nested_alive; then echo "dev up: already running ($NSIG), dev down to end it"; return 0; fi
    cmd_down >/dev/null   # a window closed by hand leaves the rest of the session behind
  fi
  nested_requires || exit 1
  [[ -n $orig_mon ]] || die "no focused monitor: run it from inside your Hyprland session"
  rm -rf "$DEV"; mkdir -p "$DEV"
  local prev_focus
  prev_focus=$(hyprctl activewindow -j | jq -r '.address // empty')
  # The far monitor first, so the window can be sent there the moment it exists.
  nested_far_up
  sandbox_build || exit 1
  sandbox_enter
  NEST_DETACH=1 nested_start || exit 1
  nested_send_away "$prev_focus"
  nested_wait_ready
  # Ends the session when its close file appears, or after DEV_TTL seconds: it must not be left running.
  setsid -f env DEV_WATCHER=1 DEVKIT_APP_ROOT="$REPO" bash -c 'for ((i = 0; i < $3 * 2; i++)); do [[ -s $1 ]] && break; sleep 0.5; done; exec "$2" down >/dev/null 2>&1' _ "$DEV/close" "$SELF" "$TTL" >/dev/null 2>&1 </dev/null
  { printf 'NSIG=%q\nNWD=%q\nNMON=%q\nNW=%q\nNH=%q\nNEST_ADDR=%q\n' "$NSIG" "$NWD" "$NMON" "$NW" "$NH" "$NEST_ADDR"; } >"$STATE"
  echo "dev up: session $NWD ${NW}x${NH} out of reach of your mouse and keyboard (look with dev shot), closes in ${TTL}s; plugin errors so far: $(plugin_errors | wc -l)"
  [[ ${DEV_WATCH:-1} == 0 ]] || cmd_watch
}

cmd_watch() {
  load
  nested_view_open "$STATE" || exit 1
  echo "dev watch: view window open on your screen (view only; dev unwatch closes it)"
}

cmd_unwatch() {
  local p
  nested_view_close
  echo "dev unwatch: view window closed"
}

cmd_down() {
  [[ -s $STATE ]] || { hyprctl output remove "$FAR_MON" >/dev/null 2>&1 || true; echo "dev down: no session"; return 0; }
  source "$STATE"
  nest_pid=detached
  nested_view_close
  nested_stop
  nested_far_down
  rm -rf "$DEV"
  echo "dev down: session ended"
}

cmd_status() {
  [[ -s $STATE ]] || { echo "dev status: down"; return 1; }
  source "$STATE"
  nested_alive || { echo "dev status: the session is gone (dev up)"; return 1; }
  echo "dev status: up $NWD ${NW}x${NH} out-of-reach, shell $(shell_up && echo answering || echo NOT-ANSWERING), window $(overlay_up && echo open || echo closed), plugin errors $(plugin_errors | wc -l), guard refused $(wc -l <"$NEST/guard.log" 2>/dev/null || echo 0)"
}

cmd_reload() {
  load
  local p env_file started took n
  p=$(procs_with "XDG_CONFIG_HOME=$NEST_HOME/.config" | while read -r q; do [[ $(cat /proc/$q/comm 2>/dev/null) == quickshell ]] && echo "$q"; done | head -n1 || true)
  [[ -n $p ]] || die "the session's shell is not running"
  mapfile -d '' env_file </proc/"$p"/environ
  : >"$NEST/qs.log"
  started=$(date +%s.%N)
  kill "$p" 2>/dev/null || true
  sleep 1
  setsid -f env -i "${env_file[@]}" QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 NEST_QS_LOG="$NEST/qs.log" \
    sh -c 'exec quickshell -n -p "${OMARCHY_PATH:-/usr/share/omarchy}/shell" >> "$NEST_QS_LOG" 2>&1'
  wait_shell || die "the session's shell did not answer after the restart"
  sleep 2
  took=$(awk -v a="$started" -v b="$(date +%s.%N)" 'BEGIN { printf "%.1f", b - a }')
  n=$(plugin_errors | wc -l)
  echo "dev reload $([[ $n -eq 0 ]] && echo ok || echo FAILED) shell restarted in ${took}s (your real shell untouched) qml-errors $n"
  plugin_errors | head -8 | cut -c1-220 | sed 's/^/  err: /'
  [[ $n -eq 0 ]]
}

# dev_window LABEL ARGS...: for an app's own command that opens a window: calls omarchy-shell ARGS in the session, then checks the window
# is up (see overlay_up) and says so. An app's dev_cmd_NAME functions use it.
dev_window() {
  local label=$1; shift
  nenv omarchy-shell "$@" >/dev/null
  sleep 1.5
  overlay_up || { echo "dev $label: the window did NOT open" >&2; exit 1; }
  echo "dev $label: window up"
}

cmd_ipc() { # TARGET METHOD [ARG...]
  load
  shell_up || die "the session's shell is not answering (dev reload)"
  [[ $# -ge 2 ]] || die "usage: dev ipc TARGET METHOD [ARG...]"
  nenv omarchy-shell "$@"
}

cmd_run() { # CMD [ARG...]: a program inside the session, detached
  load
  [[ $# -ge 1 ]] || die "usage: dev run CMD [ARG...]"
  command -v "$1" >/dev/null || die "no such program: $1"
  nenv setsid -f "$@" >/dev/null 2>&1 </dev/null
  sleep 1
  echo "dev run: $1"
}

cmd_windows() {
  load
  HYPRLAND_INSTANCE_SIGNATURE=$NSIG hyprctl clients -j | jq -r '.[] | select(.mapped) | "\(.class)\t\(.title)\tworkspace \(.workspace.id)"'
}

cmd_env() {
  load
  printf 'export HOME=%q XDG_CONFIG_HOME=%q XDG_DATA_HOME=%q XDG_STATE_HOME=%q XDG_CACHE_HOME=%q PATH=%q WAYLAND_DISPLAY=%q HYPRLAND_INSTANCE_SIGNATURE=%q\n' \
    "$NEST_HOME" "$NEST_HOME/.config" "$NEST_HOME/.local/share" "$NEST_HOME/.local/state" "$NEST_HOME/.cache" "$GUARD:$PATH" "$NWD" "$NSIG"
  # DEVKIT_ENV (NAME=value words from devkit.conf) as well, so a script in the session sees what the session's shell does.
  local kv
  for kv in ${DEVKIT_ENV[@]+"${DEVKIT_ENV[@]}"}; do printf 'export %q\n' "$kv"; done
}

cmd_set() { # JSON: merge into the plugin's entry in the session's shell.json
  load
  local cfg=$NEST_HOME/.config/omarchy/shell.json patch=${1:-}
  jq -e 'type == "object"' <<<"$patch" >/dev/null 2>&1 || die "usage: dev set JSON-OBJECT"
  jq --arg id "$ID" --argjson p "$patch" '(.plugins[] | select(.id == $id)) += $p' "$cfg" >"$cfg.new" && cat "$cfg.new" >"$cfg" && rm -f "$cfg.new"
  sleep 1.2
  echo "dev set: $patch"
}

cmd_input() {
  load
  local verb=$1; shift
  case $verb in click | rclick | type | key) overlay_up || [[ -n ${DEV_QUIET:-} ]] || echo "dev $verb: note, the app's window is not open: input goes to whatever has focus there" >&2 ;; esac
  case $verb in
    click)
      [[ $# -ge 2 ]] || die "usage: dev click PX PY"
      nest_click "$1" "$2"; sleep 0.8; echo "dev click: $1,$2" ;;
    rclick)
      [[ $# -ge 2 ]] || die "usage: dev rclick PX PY"
      nest_rclick "$1" "$2"; sleep 0.8; echo "dev rclick: $1,$2" ;;
    scroll)
      [[ $# -ge 3 ]] || die "usage: dev scroll PX PY N"
      nest_scroll "$1" "$2" "$3"; sleep 0.5; echo "dev scroll: $1,$2 by $3" ;;
    move)
      [[ $# -ge 2 ]] || die "usage: dev move PX PY"
      nest_move "$1" "$2"; sleep 0.3; echo "dev move: $1,$2" ;;
    type) [[ $# -ge 1 ]] || die "usage: dev type TEXT"; nest_type "$*"; sleep 0.4; echo "dev type: ${#1} chars" ;;
    key) [[ $# -ge 1 ]] || die "usage: dev key NAME"; nest_key "$1"; sleep 0.6; echo "dev key: $1" ;;
  esac
}

cmd_shot() {
  load
  local f=${1:-${TMPDIR:-/tmp}/dev-shot-$(date +%H%M%S).png}
  WAYLAND_DISPLAY=$NWD grim "$f" || die "grim could not capture the session"
  echo "dev shot: $f"
}

cmd_errors() {
  load
  local n; n=$(plugin_errors | wc -l)
  echo "dev errors: $n"
  plugin_errors | head -8 | cut -c1-220 | sed 's/^/  err: /'
  [[ $n -eq 0 ]]
}

case ${1:-} in
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  watch) cmd_watch ;;
  unwatch) cmd_unwatch ;;
  reload) cmd_reload ;;
  ipc) shift; cmd_ipc "$@" ;;
  run) shift; cmd_run "$@" ;;
  windows) cmd_windows ;;
  set) shift; cmd_set "${1:-}" ;;
  env) cmd_env ;;
  click | rclick | scroll | move | type | key) verb=$1; shift; cmd_input "$verb" "$@" ;;
  shot) shift; cmd_shot "$@" ;;
  errors) cmd_errors ;;
  -h | --help | help | "") usage ;;
  *)
    if declare -F "dev_cmd_$1" >/dev/null; then
      load
      shell_up || die "the session's shell is not answering (dev reload)"
      cmd=dev_cmd_$1; shift; "$cmd" "$@"
    else
      die "unknown command $1 (dev --help)"
    fi ;;
esac
